# Environment Configuration for Smart Document Assistant

# Local Ollama LLM Configuration (Privacy-Preserving Inference)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_NAME=llama3

# Server Settings
HOST=0.0.0.0
PORT=8000

# Document & Embedding Settings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Vector Store Settings
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads

# RAG Default Generation Parameters
DEFAULT_TOP_K=3
DEFAULT_TEMPERATURE=0.3
DEFAULT_TOP_P=0.9
